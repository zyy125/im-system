# MySQL container bootstrap
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=im_system
MYSQL_USER=im_user
MYSQL_PASSWORD=change-this-db-password

# Backend runtime secrets
IM_JWT_SECRET=replace-with-a-32-char-random-secret
IM_MYSQL_DSN=im_user:change-this-db-password@tcp(mysql:3306)/im_system?charset=utf8mb4&parseTime=True&loc=Local
IM_REDIS_PASSWORD=

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# Redis exporter connection
REDIS_EXPORTER_REDIS_ADDR=redis://redis:6379
REDIS_EXPORTER_REDIS_PASSWORD=

# MySQL exporter connection
MYSQL_EXPORTER_ADDRESS=mysql:3306
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=change-this-exporter-password
